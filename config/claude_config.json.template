{
  "mcpServers": {
    "libreoffice": {
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--directory",
        "/path/to/mcp-libre",
        "python",
        "src/main.py"
      ],
      "env": {
        "LIBREMCP_APPS": "writer,calc,impress,math,base",
        "LIBREMCP_ENABLE_RUN_UNO": "1"
      }
    }
  }
}
